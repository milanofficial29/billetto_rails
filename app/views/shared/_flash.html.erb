<div id="flash-messages" class="top-5 z-50 space-y-2 pointer-events-none">
  <% flash.each do |flash_type, message| %>
    <div class="alert <%= bootstrap_class_for(flash_type) %> alert-dismissible fade show" role="alert">
      <%= message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>
</div>